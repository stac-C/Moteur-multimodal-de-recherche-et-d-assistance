{
  "$schema": "https://vercel.sh",
  "installCommand": "cd /vercel/path0 && uv pip install -r requirements-vercel.txt && uv pip install --no-deps -e .",
  "buildCommand": "cd /vercel/path0 && python scripts/make_fake_artifacts.py --n-img 200 --n-aud 100",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "artifacts/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}



