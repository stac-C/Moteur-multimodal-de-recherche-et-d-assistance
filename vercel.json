{
  "installCommand": "uv pip install --system -r requirements-vercel.txt && uv pip install --system --no-deps -e .",
  "buildCommand": "python scripts/make_fake_artifacts.py --n-img 200 --n-aud 100",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "artifacts/**"
    }
  }
}
